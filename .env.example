# Copy to .env.local and fill in from the Firebase console
# (Project settings > Your apps > Web app > SDK setup and configuration).
# These identify the project; they are not secrets, but keep them out of git anyway.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check (required by Firebase AI Logic). For the hosted app, a reCAPTCHA
# Enterprise site key registered under App Check > Apps:
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=
# For localhost / device testing: "true" prints a fresh debug token in the
# browser console to register in the console, or paste a registered token here.
VITE_APPCHECK_DEBUG_TOKEN=
